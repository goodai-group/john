rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isValidAssessment() {
      return request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 200
        && request.resource.data.baseCurrency is string
        && request.resource.data.monthlyRevenue is map
        && request.resource.data.cogsCost is map;
    }

    function isValidReport() {
      return request.resource.data.projectId is string
        && request.resource.data.totalScore is number
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 100
        && request.resource.data.tier is string
        && request.resource.data.normalizedFinancials is map;
    }

    function isValidQuestion() {
      return request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 2000
        && request.resource.data.aiResponse is string;
    }

    // Assessments Collection (14 micro-business indicators and submissions)
    match /assessments/{assessmentId} {
      allow read: if true;
      allow create, update: if isValidAssessment();
      allow delete: if true;
    }

    // Reports Collection (Radar scores, gate check results, AI actionable advice)
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidReport();
      allow delete: if true;
    }

    // Questions Collection (AI consultation, edge cases, community insights)
    match /escalated_questions/{questionId} {
      allow read: if true;
      allow create: if isValidQuestion();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userFeedback', 'updatedAt']);
      allow delete: if true;
    }

    // Industry Benchmarks (Read-only for users, seedable)
    match /industry_benchmarks/{benchmarkId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
