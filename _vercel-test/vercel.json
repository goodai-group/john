{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/ai-consultation.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/[...path].ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
